# ----------------------------------------------------------------------
# Security & Hardening Rules
# ----------------------------------------------------------------------

# 1. Disable Directory Browsing (Prevents listing files in uploads/assets/etc.)
Options -Indexes

# 2. Block direct web access to sensitive file extensions
<FilesMatch "\.(sql|log|env|ini|conf|sh|bak|backup|dump|git|gitignore|yml|yaml|md|txt)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct web access to hidden files and dotfiles (.git, .github, .env)
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# 4. Block access to CodeIgniter system and application directories
RewriteRule ^(application|system|admin1947/application|admin1947/system) - [F,L]

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Route all standard requests to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.php
</IfModule>