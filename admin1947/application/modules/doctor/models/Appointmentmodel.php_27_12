		}
		if($doctor_name!='')
		{
			$this->db->where("appointment.doctor_id","$doctor_name");
			//x$this->db->where("(appointment.institute_id LIKE '%".$hospital_name."%' )");
		}
		if($payment_mode!='')
		{
			$this->db->where("appointment.payment_mode","$payment_mode");
