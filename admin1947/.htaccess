# ----------------------------------------------------------------------
# Security & Hardening Rules for Admin Panel
# ----------------------------------------------------------------------

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block direct web access to sensitive file extensions
<FilesMatch "\.(sql|log|env|ini|conf|sh|bak|backup|dump|git|gitignore|yml|yaml|md|txt)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

DirectoryIndex index.php
RewriteEngine on

# Fallback alias for legacy hospital uploads
RewriteRule ^public/assets/images/hospital/(.*)$ public/assets/upload/$1 [L]

# Delegate enterprise admin modules (operations, hr, attendance, crm) to primary application
RewriteRule ^(operations|hr|attendance|crm)(.*)$ ../index.php?/admin1947/$1$2 [L,QSA]
 
RewriteCond $1 !^(index\.php|(.*)\.swf|forums|images|css|downloads|jquery|js|robots\.txt|favicon\.ico)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ ./index.php?$1 [L,QSA]
